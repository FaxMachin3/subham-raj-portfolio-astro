---
import { site } from '@/data/site';
import ThemeSwitch from './ThemeSwitch.astro';

const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#fixes', label: 'The fixes' },
  { href: '/#experience', label: 'Experience' },
  { href: '/resume', label: 'Résumé' },
];
---

<header class="site-header">
  <div class="wrap site-header__inner">
    {/* Named by its visible text, so speech input ("click subham raj") works; the space sits in the dot. */}
    <a class="brand" href="/">
      <span class="brand__word">
        subham<span class="brand__dot"> </span>raj
      </span>
      <span class="sr-only">(home)</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    {/* Native disclosure remains usable without JavaScript. */}
    <details class="mobile-nav" data-mobile-nav>
      <summary class="mobile-nav__button" aria-controls="mobile-navigation">
        <span class="sr-only" data-menu-label>
          Open navigation
        </span>
        <span class="mobile-nav__icon" aria-hidden="true">
          <i></i>
          <i></i>
        </span>
      </summary>
      <div class="mobile-nav__panel" id="mobile-navigation">
        <nav aria-label="Main">
          <ul>
            {links.map((link, index) => (
              <li>
                <a href={link.href}>
                  <span class="mobile-nav__number" aria-hidden="true">
                    0{index + 1}
                  </span>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="mobile-nav__footer">
          <p>
            {site.availability} · {site.workMode}
          </p>
          <div class="mobile-nav__contacts">
            <a class="btn btn--solid" href={`mailto:${site.email}`}>
              Email me
            </a>
            <a class="btn" href={site.links.linkedin}>
              LinkedIn
            </a>
            <a class="btn" href={site.links.github}>
              GitHub
            </a>
          </div>
        </div>
      </div>
    </details>
    <ThemeSwitch />
  </div>
</header>

<script>
  import { enhanceMobileNav } from '@/lib/mobile-nav';

  enhanceMobileNav(document.querySelector<HTMLDetailsElement>('[data-mobile-nav]')!);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-header-bg);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    height: var(--header-height);
    gap: var(--space-4);
  }

  .brand {
    display: flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand__word {
    display: inline-flex;
    align-items: baseline;
    font-size: 1.22rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    view-transition-name: brand;
  }

  /* The dot is a status light that mirrors the site: healthy, broken, fixing, fixed. */
  .brand__dot {
    overflow: hidden;
    width: 0.34em;
    height: 0.34em;
    margin: 0 0.1em;
    border-radius: 50%;
    background: var(--color-status-ok);
    transform: translateY(-0.04em);
    transition: background-color 0.3s;
  }

  :global(html[data-site='broken']) .brand__dot {
    background: var(--color-status-bad);
    animation: dot-alarm 0.7s ease-in-out infinite;
  }

  :global(html[data-site='fixing']) .brand__dot {
    background: var(--color-status-busy);
    animation: dot-work 0.9s ease-in-out infinite;
  }

  :global(html[data-site='fixed']) .brand__dot {
    animation: dot-pop 0.6s var(--ease-spring);
  }

  @keyframes dot-alarm {
    50% {
      opacity: 0.3;
      transform: translateY(-0.04em) scale(0.8);
    }
  }

  @keyframes dot-work {
    50% {
      transform: translateY(-0.04em) scale(1.35);
    }
  }

  @keyframes dot-pop {
    from {
      transform: translateY(-0.04em) scale(2.4);
    }
  }

  .site-nav {
    margin-left: auto;
  }

  nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav ul {
    display: flex;
    gap: var(--space-1);
  }

  nav a,
  .mobile-nav__button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
  }

  nav a {
    color: var(--color-muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-ink);
    background: var(--color-hover);
  }

  .mobile-nav {
    display: none;
    margin-left: auto;
  }

  .mobile-nav__button {
    justify-content: center;
    width: 44px;
    padding: 0;
    border: 1px solid var(--color-line);
    list-style: none;
    cursor: pointer;
  }

  .mobile-nav__button::-webkit-details-marker {
    display: none;
  }

  .mobile-nav__panel {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: calc(var(--header-height) + 2rem) 24px calc(24px + env(safe-area-inset-bottom));
    overflow: auto;
    overscroll-behavior: contain;
    background: var(--color-paper);
  }

  .mobile-nav__panel nav a {
    display: flex;
    gap: 1rem;
    padding: 0.35rem 0;
    color: var(--color-ink);
    font-size: clamp(2rem, 10vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.3;
  }
  .mobile-nav__number {
    color: var(--color-muted);
    font: 400 0.7rem var(--font-mono);
    letter-spacing: 0;
  }
  .mobile-nav__footer {
    border-top: 1px solid var(--color-line);
    padding-top: 1rem;
  }
  .mobile-nav__footer p {
    color: var(--color-muted);
    font: 0.75rem/1.5 var(--font-mono);
  }
  .mobile-nav__contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .mobile-nav__contacts .btn {
    flex: 1;
    font-size: 0.8rem;
    padding: 0.6rem 0.5rem;
  }
  .mobile-nav__icon {
    position: relative;
    width: 18px;
    height: 14px;
  }
  .mobile-nav__icon i {
    position: absolute;
    inset: 3px 0 auto;
    height: 2px;
    background: var(--color-ink);
    transition: transform 260ms ease;
  }
  .mobile-nav__icon i + i {
    top: 9px;
  }
  .mobile-nav[open]:not([data-closing]) .mobile-nav__icon i {
    transform: translateY(3px) rotate(45deg);
  }
  .mobile-nav[open]:not([data-closing]) .mobile-nav__icon i + i {
    transform: translateY(-3px) rotate(-45deg);
  }

  @media (max-width: 720px) {
    :global(html:has([data-mobile-nav][open])) {
      overflow: hidden;
    }
    .site-nav {
      display: none;
    }

    .mobile-nav {
      display: block;
    }
    .site-header:has(.mobile-nav[open]) {
      backdrop-filter: none;
      background: transparent;
    }
    .site-header:has(.mobile-nav[open]) .brand,
    .mobile-nav__button,
    :global(.site-header:has([data-mobile-nav][open]) .theme-cycle) {
      position: relative;
      z-index: 2;
    }
  }

  @media (max-width: 400px) {
    .site-header__inner {
      gap: var(--space-2);
    }

    .brand__word {
      font-size: 1.1rem;
    }
  }
</style>
