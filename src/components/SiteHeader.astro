---
import { site } from '@/data/site';
import ThemeSwitch from './ThemeSwitch.astro';

const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#fixes', label: 'The fixes' },
  { href: '/#experience', label: 'Experience' },
  { href: '/resume', label: 'Résumé' },
];
---

<header class="site-header">
  <div class="wrap site-header__inner">
    {/* Named by its visible text, so speech input ("click subham raj") works; the space sits in the dot. */}
    <a class="brand" href="/">
      <span class="brand__word">
        subham<span class="brand__dot"> </span>raj
      </span>
      <span class="sr-only">(home)</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    {/* Phones: the same links plus email, behind one button, so nothing is hidden on small screens. */}
    <details class="mobile-nav" data-mobile-nav>
      <summary class="mobile-nav__button">Menu</summary>
      <nav class="mobile-nav__panel" aria-label="Main">
        <ul>
          {links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
          <li>
            <a href={`mailto:${site.email}`}>Email</a>
          </li>
        </ul>
      </nav>
    </details>
    <ThemeSwitch />
  </div>
</header>

<script>
  import { enhanceMobileNav } from '@/lib/mobile-nav';

  enhanceMobileNav(document.querySelector<HTMLDetailsElement>('[data-mobile-nav]')!);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-header-bg);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    height: var(--header-height);
    gap: var(--space-4);
  }

  .brand {
    display: flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand__word {
    display: inline-flex;
    align-items: baseline;
    font-size: 1.22rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    view-transition-name: brand;
  }

  /* The dot is a status light that mirrors the site: healthy, broken, fixing, fixed. */
  .brand__dot {
    overflow: hidden;
    width: 0.34em;
    height: 0.34em;
    margin: 0 0.1em;
    border-radius: 50%;
    background: var(--color-status-ok);
    transform: translateY(-0.04em);
    transition: background-color 0.3s;
  }

  :global(html[data-site='broken']) .brand__dot {
    background: var(--color-status-bad);
    animation: dot-alarm 0.7s ease-in-out infinite;
  }

  :global(html[data-site='fixing']) .brand__dot {
    background: var(--color-status-busy);
    animation: dot-work 0.9s ease-in-out infinite;
  }

  :global(html[data-site='fixed']) .brand__dot {
    animation: dot-pop 0.6s var(--ease-spring);
  }

  @keyframes dot-alarm {
    50% {
      opacity: 0.3;
      transform: translateY(-0.04em) scale(0.8);
    }
  }

  @keyframes dot-work {
    50% {
      transform: translateY(-0.04em) scale(1.35);
    }
  }

  @keyframes dot-pop {
    from {
      transform: translateY(-0.04em) scale(2.4);
    }
  }

  .site-nav {
    margin-left: auto;
  }

  nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav ul {
    display: flex;
    gap: var(--space-1);
  }

  nav a,
  .mobile-nav__button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
  }

  nav a {
    color: var(--color-muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-ink);
    background: var(--color-hover);
  }

  .mobile-nav {
    position: relative;
    display: none;
    margin-left: auto;
  }

  .mobile-nav__button {
    border: 1px solid var(--color-line);
    list-style: none;
    cursor: pointer;
  }

  .mobile-nav__button::-webkit-details-marker {
    display: none;
  }

  .mobile-nav__panel {
    position: absolute;
    top: calc(100% + var(--space-2));
    right: 0;
    min-width: 12rem;
    padding: var(--space-2);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .mobile-nav__panel a {
    display: flex;
  }

  @media (max-width: 720px) {
    .site-nav {
      display: none;
    }

    .mobile-nav {
      display: block;
    }
  }

  @media (max-width: 400px) {
    .site-header__inner {
      gap: var(--space-2);
    }

    .brand__word {
      font-size: 1.1rem;
    }
  }
</style>
