---
import { site } from '@/data/site';
import ThemeSwitch from './ThemeSwitch.astro';

const links = [
  { href: '/#work', label: 'Work', desktopOnly: false, hideOnTiny: true },
  { href: '/#fixes', label: 'The fixes', desktopOnly: true, hideOnTiny: true },
  { href: '/#experience', label: 'Experience', desktopOnly: true, hideOnTiny: true },
  { href: '/resume', label: 'Résumé', desktopOnly: false, hideOnTiny: false },
];
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <span class="brand__word" aria-hidden="true">
        subham<span class="brand__dot"></span>raj
      </span>
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((link) => (
          <li class:list={{ 'desktop-only': link.desktopOnly, 'hide-tiny': link.hideOnTiny }}>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <ThemeSwitch />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-header-bg);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    height: var(--header-height);
    gap: var(--space-4);
  }

  .brand {
    display: flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand__word {
    display: inline-flex;
    align-items: baseline;
    font-size: 1.22rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    view-transition-name: brand;
  }

  /* The dot is a status light that mirrors the site: healthy, broken, fixing, fixed. */
  .brand__dot {
    width: 0.34em;
    height: 0.34em;
    margin: 0 0.1em;
    border-radius: 50%;
    background: var(--color-status-ok);
    transform: translateY(-0.04em);
    transition: background-color 0.3s;
  }

  :global(html[data-site='broken']) .brand__dot {
    background: var(--color-status-bad);
    animation: dot-alarm 0.7s ease-in-out infinite;
  }

  :global(html[data-site='fixing']) .brand__dot {
    background: var(--color-status-busy);
    animation: dot-work 0.9s ease-in-out infinite;
  }

  :global(html[data-site='fixed']) .brand__dot {
    animation: dot-pop 0.6s var(--ease-spring);
  }

  @keyframes dot-alarm {
    50% {
      opacity: 0.3;
      transform: translateY(-0.04em) scale(0.8);
    }
  }

  @keyframes dot-work {
    50% {
      transform: translateY(-0.04em) scale(1.35);
    }
  }

  @keyframes dot-pop {
    from {
      transform: translateY(-0.04em) scale(2.4);
    }
  }

  nav {
    margin-left: auto;
  }

  nav ul {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-size: 0.9rem;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-ink);
    background: var(--color-hover);
  }

  @media (max-width: 720px) {
    .desktop-only {
      display: none;
    }

    nav a {
      padding: 0 var(--space-2);
    }
  }

  @media (max-width: 480px) {
    .site-header__inner {
      gap: var(--space-2);
    }
  }

  /* Smallest phones: the Work section is one scroll away, and the theme switch needs the room. */
  @media (max-width: 400px) {
    .hide-tiny {
      display: none;
    }

    .brand__word {
      font-size: 1.1rem;
    }
  }
</style>
