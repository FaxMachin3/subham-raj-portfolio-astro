---
import { requireMetric, unbreakable } from '@/lib/metrics';
import { site } from '@/data/site';

const highlights = [
  requireMetric('plotMatching'),
  requireMetric('bundleCut'),
  requireMetric('mergedPrs'),
  requireMetric('orionLaunch'),
];
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero__main">
    <p class="hero__kicker mono">
      <span class="hero__role">{site.role}</span>8 years · React · TypeScript · ex-TRM Labs, Paytm ·{' '}
      {site.availability.toLowerCase()}
    </p>
    <h1 id="hero-title">
      I make broken interfaces{' '}
      <span class="nowrap">
        <span class="word word--fast">fast</span>,
      </span>{' '}
      <span class="word word--accessible">accessible</span> and{' '}
      <span class="word word--global">
        <span class="word__text">global</span>
      </span>
      .
    </h1>
    <p class="hero__lede">
      I build data-heavy and AI product interfaces in React and TypeScript, with a focus on performance and
      accessibility.
    </p>
    <div class="hero__actions">
      <a class="btn btn--solid" href="#work">
        View selected work
      </a>
      <a class="btn" href="/resume">
        Résumé
      </a>
      <a class="hero__lab-link" href="#fixes">
        Explore the interactive lab ↓
      </a>
    </div>
  </div>
  <p class="hero__highlights-label mono">From my production work at TRM Labs</p>
  <ul class="hero__highlights" aria-label="Highlights from my production work at TRM Labs">
    {highlights.map((m) => (
      <li>
        <strong>{unbreakable(m.value)}</strong>
        <span>{m.label}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .hero {
    padding-block: var(--space-16) var(--space-8);
  }

  .hero__kicker {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    margin: 0 0 var(--space-4);
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  .hero__role {
    padding: 0.1rem 0.5rem;
    border-radius: 6px;
    background: var(--color-ink);
    color: var(--color-on-ink);
  }

  h1 {
    max-width: 15ch;
    margin: 0 0 var(--space-6);
    font-size: var(--text-h1);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.02;
  }

  .nowrap {
    white-space: nowrap;
  }

  .word {
    display: inline-block;
    transition: color 0.5s;
  }

  .word--fast {
    color: var(--color-good);
  }

  .word--accessible {
    color: var(--color-accent);
  }

  .word--global {
    position: relative;
    color: var(--color-violet);
  }

  .word__text {
    display: inline-block;
  }

  /*
   * The raw key is overlaid on the word, so breaking/fixing never changes the headline's layout. It is a
   * pseudo-element, not text: it never ends up in the heading's text (search snippets, copy and paste), and
   * assistive tech hears "global" through the alt text.
   */
  .word--global::after {
    content: '{{hero.global}}';
    content: '{{hero.global}}' / 'global';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
    visibility: hidden;
    /* Sized in every state: a hidden full-size key would still widen the page on small phones. */
    font-family: var(--font-mono);
    font-size: 0.34em;
    letter-spacing: 0;
  }

  /*
   * Each word breaks and heals with the fixes it stands for (see HERO_WORDS): "fast" with the four
   * performance demos, "accessible" with Fix 05, "global" with Fix 06. Broken styling stays readable
   * (AA for large text), so breaking the demo never harms the real page.
   */
  :global(html[data-fast='broken']) .word--fast {
    color: var(--color-hero-dim);
    filter: blur(1.2px);
    animation: jitter 0.18s steps(2) infinite;
  }

  :global(html[data-accessible='broken']) .word--accessible {
    color: var(--color-hero-dim);
    text-decoration: line-through 4px var(--color-bad);
  }

  :global(html[data-global='broken']) .word__text {
    visibility: hidden;
  }

  :global(html[data-global='broken']) .word--global::after {
    visibility: visible;
    color: var(--color-bad);
  }

  :global(html[data-fast='healed']) .word--fast,
  :global(html[data-accessible='healed']) .word--accessible,
  :global(html[data-global='healed']) .word__text {
    animation: word-heal 0.7s var(--ease-spring);
  }

  /* A one-off glitch across the headline the moment the site starts breaking. */
  :global(html[data-site='breaking']) h1 {
    animation: headline-glitch 0.42s steps(3) 1;
  }

  /* Transform and opacity only: animating filter here crashed WebKit's compositor (WPE) mid-run. */
  @keyframes word-heal {
    from {
      transform: scale(1.18) translateY(-0.04em);
      opacity: 0.55;
    }
  }

  @keyframes headline-glitch {
    0% {
      transform: translateX(-4px) skewX(-4deg);
      text-shadow:
        3px 0 var(--color-bad),
        -3px 0 var(--color-accent);
    }
    50% {
      transform: translateX(4px) skewX(3deg);
      text-shadow:
        -3px 0 var(--color-bad),
        3px 0 var(--color-accent);
    }
    100% {
      transform: none;
      text-shadow: none;
    }
  }

  @keyframes jitter {
    from {
      transform: translate(-3px, 1px) skewX(-6deg);
    }
    to {
      transform: translate(3px, -1px) skewX(5deg);
    }
  }

  .hero__lede {
    max-width: 40rem;
    margin: 0 0 var(--space-6);
    color: var(--color-muted);
    font-size: var(--text-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0 0 var(--space-8);
  }

  .hero__lab-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-ink);
    font-weight: 600;
    text-underline-offset: 3px;
  }

  .hero__highlights-label {
    margin: var(--space-12) 0 var(--space-3);
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  .hero__highlights {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__highlights li {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .hero__highlights strong {
    display: block;
    font-size: 1.2rem;
    line-height: 1.3;
  }

  .hero__highlights span {
    display: block;
    margin-top: var(--space-1);
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: var(--space-12);
    }

    .hero__highlights {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
