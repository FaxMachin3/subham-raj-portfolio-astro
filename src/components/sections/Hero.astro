---
import BreakFixControls from '@/components/islands/BreakFixControls';
import { requireMetric, unbreakable } from '@/lib/metrics';

const highlights = [
  requireMetric('plotMatching'),
  requireMetric('bundleCut'),
  requireMetric('mergedPrs'),
  requireMetric('orionLaunch'),
];
---

<section class="hero wrap" aria-labelledby="hero-title">
  <p class="hero__kicker mono">
    <span class="hero__role">Senior Frontend Engineer</span>8 years · React · TypeScript · ex-TRM Labs, Paytm
  </p>
  <h1 id="hero-title">
    I make broken interfaces{' '}
    <span class="nowrap">
      <span class="word word--fast">fast</span>,
    </span>{' '}
    <span class="word word--accessible">accessible</span> and{' '}
    <span class="word word--global">
      <span class="word__text">global</span>
      <span class="word__key" aria-hidden="true">
        {'{{hero.global}}'}
      </span>
    </span>
    .
  </h1>
  <p class="hero__lede">
    This page is a working demo. <strong>Break it, then watch me fix it.</strong> Each problem is a
    re-creation of one I fixed in production, and every number you see is measured live, in your browser.
  </p>
  <BreakFixControls client:idle />
  <ul class="hero__highlights" aria-label="Highlights">
    {highlights.map((m) => (
      <li>
        <strong>{unbreakable(m.value)}</strong>
        <span>{m.label}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .hero {
    padding-block: var(--space-16) var(--space-8);
  }

  .hero__kicker {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    margin: 0 0 var(--space-4);
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  .hero__role {
    padding: 0.1rem 0.5rem;
    border-radius: 6px;
    background: var(--color-ink);
    color: #fff;
  }

  h1 {
    max-width: 15ch;
    margin: 0 0 var(--space-6);
    font-size: var(--text-h1);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.02;
  }

  .nowrap {
    white-space: nowrap;
  }

  .word {
    display: inline-block;
    transition:
      color 0.5s,
      filter 0.5s;
  }

  .word--fast {
    color: var(--color-good);
  }

  .word--accessible {
    color: var(--color-accent);
  }

  .word--global {
    position: relative;
    color: var(--color-violet);
  }

  /* The raw key is overlaid on the word, so breaking/fixing never changes the headline's layout. */
  .word__key {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
    visibility: hidden;
    /* Sized in every state: a hidden full-size key would still widen the page on small phones. */
    font-family: var(--font-mono);
    font-size: 0.34em;
    letter-spacing: 0;
  }

  /* Broken styling stays readable (AA for large text): broken mode never harms the real page. */
  :global(html[data-site='broken']) .word--fast {
    color: #6e6d66;
    filter: blur(1.2px);
    animation: jitter 0.18s steps(2) infinite;
  }

  :global(html[data-site='broken']) .word--accessible {
    color: #6e6d66;
    text-decoration: line-through 4px var(--color-bad);
  }

  :global(html[data-site='broken']) .word__text {
    visibility: hidden;
  }

  :global(html[data-site='broken']) .word__key {
    visibility: visible;
    color: var(--color-bad);
  }

  @keyframes jitter {
    from {
      transform: translate(-3px, 1px) skewX(-6deg);
    }
    to {
      transform: translate(3px, -1px) skewX(5deg);
    }
  }

  .hero__lede {
    max-width: 40rem;
    margin: 0 0 var(--space-6);
    color: var(--color-muted);
    font-size: var(--text-lg);
  }

  .hero__lede strong {
    color: var(--color-ink);
  }

  .hero__highlights {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
    margin: var(--space-12) 0 0;
    padding: 0;
    list-style: none;
  }

  .hero__highlights li {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .hero__highlights strong {
    display: block;
    font-size: 1.2rem;
    line-height: 1.3;
  }

  .hero__highlights span {
    display: block;
    margin-top: var(--space-1);
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: var(--space-12);
    }

    .hero__highlights {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
