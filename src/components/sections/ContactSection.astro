---
import { site } from '@/data/site';
---

<section class="wrap" id="contact" aria-labelledby="contact-title">
  <div class="contact">
    <h2 id="contact-title">Got something that needs fixing?</h2>
    <div class="contact__links">
      <a class="btn btn--light" href={`mailto:${site.email}`}>
        Email me
      </a>
      <a class="btn btn--outline-light" href={site.links.linkedin} rel="me">
        LinkedIn
      </a>
      <a class="btn btn--outline-light" href={site.links.github} rel="me">
        GitHub
      </a>
      <a class="btn btn--outline-light" href={site.links.resumePdf} download>
        Résumé (PDF)
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-6);
    margin-top: var(--space-16);
    padding: clamp(1.75rem, 5vw, 3.75rem);
    border-radius: var(--radius-xl);
    background: var(--color-ink);
    color: #fff;
  }

  h2 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2rem, 1.4rem + 3vw, 3.4rem);
    letter-spacing: -0.03em;
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .btn--light {
    background: #fff;
    border-color: #fff;
    color: var(--color-ink);
  }

  .btn--outline-light {
    border-color: #fff;
    color: #fff;
  }

  .contact .btn:hover {
    box-shadow: 4px 4px 0 #34d399;
  }
</style>
