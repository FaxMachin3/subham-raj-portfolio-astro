---
import { getCollection } from 'astro:content';
import { requireMetric, unbreakable } from '@/lib/metrics';

const studies = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<section class="section wrap" id="work" aria-labelledby="work-title">
  <div class="section-head" data-reveal>
    <h2 id="work-title">Case studies</h2>
    <p>The context, constraints and trade-offs behind the demos.</p>
  </div>
  <ul class="studies">
    {studies.map((study) => {
      const headline = study.data.metrics[0] ? requireMetric(study.data.metrics[0]) : undefined;
      return (
        <li data-reveal>
          <a class="study card" href={`/work/${study.id}`}>
            <span class="study__meta mono">
              {study.data.company} · {study.data.role}
            </span>
            <h3 style={`view-transition-name: study-${study.id}; view-transition-class: study-title`}>
              {study.data.title}
            </h3>
            <p>{study.data.summary}</p>
            {headline && (
              <span class="study__metric">
                <strong>{unbreakable(headline.value)}</strong> {headline.label}
              </span>
            )}
            <span class="study__cta" aria-hidden="true">
              Read the case study →
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .studies {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .study {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-6);
    text-decoration: none;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .study:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-pop);
  }

  .study__meta {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .study h3 {
    margin: 0;
    font-size: 1.25rem;
  }

  .study p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .study__metric {
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .study__metric strong {
    color: var(--color-good);
    font-family: var(--font-mono);
  }

  .study__cta {
    margin-top: auto;
    padding-top: var(--space-2);
    font-weight: 600;
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    .studies {
      grid-template-columns: 1fr;
    }
  }
</style>
