---
const options = [
  {
    value: 'system',
    label: 'System theme',
    icon: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>',
  },
  {
    value: 'light',
    label: 'Light theme',
    icon: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  },
  { value: 'dark', label: 'Dark theme', icon: '<path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z"/>' },
] as const;
---

<fieldset class="theme-switch">
  <legend class="sr-only">Colour theme</legend>
  {options.map((o) => (
    <label class="theme-switch__option" title={o.label}>
      <input type="radio" name="theme" value={o.value} checked={o.value === 'system'} />
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        set:html={o.icon}
      />
      <span class="sr-only">{o.label}</span>
    </label>
  ))}
</fieldset>

<button
  type="button"
  class="theme-cycle"
  data-preference="system"
  aria-label="Colour theme: System. Change theme"
>
  {options.map((o) => (
    <svg
      class={`theme-cycle__icon theme-cycle__icon--${o.value}`}
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={o.icon}
    />
  ))}
</button>

<script>
  import { initThemeSwitch } from '@/lib/theme';

  initThemeSwitch();
</script>

<style is:global>
  /* During the theme switch the new snapshot is revealed by a clip-path circle, not a crossfade. */
  html.theme-transition::view-transition-old(root),
  html.theme-transition::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }
</style>

<style>
  .theme-switch {
    display: flex;
    flex-shrink: 0;
    gap: 2px;
    margin: 0;
    padding: 3px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface);
  }

  .theme-switch__option {
    position: relative;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    color: var(--color-muted);
    cursor: pointer;
  }

  .theme-switch__option:hover {
    color: var(--color-ink);
    background: var(--color-hover);
  }

  .theme-switch input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .theme-switch__option:has(input:checked) {
    background: var(--color-ink);
    color: var(--color-on-ink);
  }

  .theme-switch__option:has(input:focus-visible) {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .theme-cycle {
    display: none;
    flex-shrink: 0;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-ink);
    cursor: pointer;
  }

  .theme-cycle__icon {
    display: none;
  }

  .theme-cycle[data-preference='system'] .theme-cycle__icon--system,
  .theme-cycle[data-preference='light'] .theme-cycle__icon--light,
  .theme-cycle[data-preference='dark'] .theme-cycle__icon--dark {
    display: block;
  }

  @media (max-width: 480px) {
    .theme-switch {
      display: none;
    }

    .theme-cycle {
      display: grid;
    }
  }

  @media (forced-colors: active) {
    .theme-switch__option:has(input:checked) {
      outline: 2px solid Highlight;
    }
  }
</style>
