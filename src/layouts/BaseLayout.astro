---
// Latin subsets only: other scripts (e.g. Devanagari in the i18n demo) use the system font stack.
import '@/styles/fonts.css';
import '@/styles/global.css';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { site } from '@/data/site';
import { cleanPath } from '@/lib/url';

interface Props {
  /** Page title; the site name is appended. Omit on the homepage. */
  title?: string;
  description?: string;
  /** Schema.org nodes for this page, emitted as one JSON-LD @graph. */
  graph?: Record<string, unknown>[];
  ogType?: 'website' | 'article' | 'profile';
  /** Slug of the build-time social image in src/pages/og. */
  ogImage?: string;
  /** Article dates for social previews. */
  published?: Date;
  updated?: Date;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  graph,
  ogType = 'website',
  ogImage = 'home',
  published,
  updated,
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(cleanPath(Astro.url.pathname), Astro.site);
const ogImageUrl = new URL(`/og/${ogImage}.png`, Astro.site);
const ogAlt = title ?? site.title;
---

<!doctype html>
<html lang="en" data-site="healthy">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      document.documentElement.dataset.hud = 'collapsed';
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
        if (localStorage.getItem('hud') === 'expanded') delete document.documentElement.dataset.hud;
      } catch {}
    </script>
    <style is:inline>
      /* Keep a themed canvas before the external stylesheet arrives. Never hide content. */
      html {
        color-scheme: light dark;
        background: #f5f4ef;
      }
      @media (prefers-color-scheme: dark) {
        html:not([data-theme='light']) {
          background: #121211;
        }
      }
      html[data-theme='light'] {
        color-scheme: light;
      }
      html[data-theme='dark'] {
        color-scheme: dark;
        background: #121211;
      }
    </style>
    <script is:inline>
      // Native history remains in charge. A rebuilt page may need its position
      // corrected after WebKit clamps the offset to partially parsed HTML.
      (() => {
        if (location.pathname !== '/') return;
        const key = 'portfolioNativeReturn';
        history.scrollRestoration = 'auto';
        const restore = () => {
          const position = history.state?.[key];
          if (
            position?.href !== location.href ||
            !Number.isFinite(position.x) ||
            !Number.isFinite(position.y)
          )
            return;
          if (Math.abs(scrollX - position.x) > 1 || Math.abs(scrollY - position.y) > 1)
            scrollTo({ left: position.x, top: position.y, behavior: 'instant' });
        };
        // WebKit may expose navigation timing only once parsing has progressed.
        const isReturn = () =>
          performance.getEntriesByType('navigation')[0]?.type === 'back_forward' ||
          window.navigation?.activation?.navigationType === 'traverse';
        addEventListener(
          'DOMContentLoaded',
          () => {
            if (isReturn()) restore();
          },
          { once: true },
        );
        addEventListener('pageshow', (event) => {
          if (event.persisted || isReturn()) restore();
          // Native restoration can run after pageshow and overwrite a correction.
          requestAnimationFrame(() => {
            if (event.persisted || isReturn()) restore();
          });
        });
        document.addEventListener('click', (event) => {
          if (
            event.defaultPrevented ||
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          )
            return;
          const link = event.target instanceof Element ? event.target.closest('a') : null;
          if (!link || link.hasAttribute('download') || (link.target && link.target !== '_self')) return;
          const destination = new URL(link.href);
          if (
            destination.origin !== location.origin ||
            !/^\/(work|writing)\/[^/]+$/.test(destination.pathname)
          )
            return;
          history.replaceState(
            { ...history.state, [key]: { href: location.href, x: scrollX, y: scrollY } },
            '',
          );
        });
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="author" content={site.name} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f5f4ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121211" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // WebKit captures a page transition's incoming frame before it jumps to the #fragment, so a link to
      // /#work would crossfade in from the hero and then jump. Jump first if the section is already parsed
      // (pagereveal fires just before that first frame); otherwise skip the transition. Only on a fresh
      // navigation's first reveal: Back, reload and back/forward-cache restores keep the restored position.
      addEventListener(
        'pagereveal',
        (e) => {
          const type =
            window.navigation?.activation?.navigationType ??
            performance.getEntriesByType('navigation')[0]?.type;
          if (type !== 'push' && type !== 'navigate') return;
          if (performance.getEntriesByType('navigation')[0]?.type === 'back_forward') return;
          if (!location.hash) return;
          let fragment;
          try {
            fragment = decodeURIComponent(location.hash.slice(1));
          } catch {
            return;
          }
          const target = document.getElementById(fragment);
          if (target) target.scrollIntoView({ block: 'start', behavior: 'instant' });
          else e.viewTransition?.skipTransition();
        },
        { once: true },
      );
      // Going back to the homepage is the shorter, closing transition (global.css reads data-vt-dir).
      addEventListener('pagereveal', (e) => {
        if (!e.viewTransition) return;
        const root = document.documentElement;
        root.dataset.vtDir = location.pathname === '/' ? 'return' : 'open';
        e.viewTransition.finished.finally(() => delete root.dataset.vtDir);
      });
      // Smooth scrolling starts once the page (and any jump to its #fragment) has loaded; see global.css.
      addEventListener(
        'load',
        () => requestAnimationFrame(() => document.documentElement.classList.add('smooth-scroll')),
        { once: true },
      );
    </script>
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    {ogType === 'profile' && <meta property="profile:first_name" content="Subham" />}
    {ogType === 'profile' && <meta property="profile:last_name" content="Raj" />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    {ogType === 'article' && <meta property="article:author" content={site.url} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {graph && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}
      />
    )}
  </head>
  <body>
    <script is:inline>
      // A data URL still uses WebKit's asynchronous URL loader. Prime the already downloaded bytes
      // before parsing any text instead. Keep the CSS face unless binary decoding succeeds; it also
      // remains the normal font-loading path when JavaScript is disabled or CSSOM access is blocked.
      (() => {
        if (typeof FontFace === 'undefined') return;
        for (const sheet of document.styleSheets) {
          try {
            for (let index = sheet.cssRules.length - 1; index >= 0; index--) {
              const rule = sheet.cssRules[index];
              if (!(rule instanceof CSSFontFaceRule)) continue;
              const encoded = rule.style
                .getPropertyValue('src')
                .match(/data:font\/woff2;base64,([A-Za-z0-9+/=]+)/)?.[1];
              if (!encoded) continue;
              const bytes = Uint8Array.from(atob(encoded), (character) => character.charCodeAt(0));
              const face = new FontFace(rule.style.getPropertyValue('font-family'), bytes, {
                weight: rule.style.getPropertyValue('font-weight'),
                style: rule.style.getPropertyValue('font-style'),
                display: 'swap',
              });
              face.loaded.catch(() => {});
              if (face.status !== 'loaded') continue;
              document.fonts.add(face);
              sheet.deleteRule(index);
            }
          } catch {
            // Other-origin stylesheets and unsupported APIs retain their declarative CSS fallback.
          }
        }
      })();
    </script>
    <a class="skip-link" href="#main" tabindex="0">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <slot name="after" />
  </body>
</html>
