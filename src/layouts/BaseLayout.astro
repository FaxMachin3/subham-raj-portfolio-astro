---
// Latin subsets only: other scripts (e.g. Devanagari in the i18n demo) use the system font stack.
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-800.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@/styles/global.css';
import heroFont from '@fontsource/poppins/files/poppins-latin-800-normal.woff2?url';
import bodyFont from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { site } from '@/data/site';
import { cleanPath } from '@/lib/url';

interface Props {
  /** Page title; the site name is appended. Omit on the homepage. */
  title?: string;
  description?: string;
  /** Schema.org nodes for this page, emitted as one JSON-LD @graph. */
  graph?: Record<string, unknown>[];
  ogType?: 'website' | 'article' | 'profile';
  /** Slug of the build-time social image in src/pages/og. */
  ogImage?: string;
  /** Article dates for social previews. */
  published?: Date;
  updated?: Date;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  graph,
  ogType = 'website',
  ogImage = 'home',
  published,
  updated,
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(cleanPath(Astro.url.pathname), Astro.site);
const ogImageUrl = new URL(`/og/${ogImage}.png`, Astro.site);
const ogAlt = title ?? site.title;
---

<!doctype html>
<html lang="en" data-site="healthy">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="author" content={site.name} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={heroFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f5f4ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121211" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Runs before first paint so a saved theme never flashes. Key must match src/lib/theme.ts.
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    {ogType === 'profile' && <meta property="profile:first_name" content="Subham" />}
    {ogType === 'profile' && <meta property="profile:last_name" content="Raj" />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    {ogType === 'article' && <meta property="article:author" content={site.url} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {graph && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}
      />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <slot name="after" />
  </body>
</html>
