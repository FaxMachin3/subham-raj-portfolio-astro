{
  "name": "subham-raj-portfolio",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "i18n:types": "node scripts/i18n-types.mjs",
    "i18n:check": "node scripts/i18n-types.mjs --check",
    "demos:generate": "node scripts/generate-demo-chunks.mjs",
    "budget": "node scripts/check-budget.mjs",
    "verify": "npm run i18n:check && npm run check && npm run lint && npm run format:check && npm run test && npm run build && npm run budget && npm run test:e2e",
    "test:coverage": "COVERAGE=1 vitest run",
    "test:e2e:coverage": "COVERAGE=1 astro build && COVERAGE=1 playwright test --project=chromium-desktop --project=android-small-360; status=$?; astro build && exit $status",
    "coverage": "npm run test:coverage && npm run test:e2e:coverage && node coverage-config/merge.mjs",
    "walkthrough": "playwright test --config playwright.walkthrough.config.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@nanostores/react": "^2.0.1",
    "astro": "^7.3.5",
    "nanostores": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "minimatch": "^10.2.6",
    "monocart-coverage-reports": "^2.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "satori": "^0.35.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "description": "Portfolio of Subham Raj, Senior Frontend Engineer. Break the site, watch him fix it."
}
